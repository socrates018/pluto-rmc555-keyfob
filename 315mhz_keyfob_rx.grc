- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\n\nclass\
      \ blk(gr.basic_block):\n\n    def __init__(self):\n        gr.basic_block.__init__(\n\
      \            self,\n            name=\"RMC555 Pulse Decoder\",\n           \
      \ in_sig=[np.float32],\n            out_sig=[]\n        )\n\n        self.message_port_register_out(pmt.intern(\"\
      out\"))\n\n        self.last_state = 0\n        self.count = 0\n        self.bits\
      \ = \"\"\n\n\n    def general_work(self, input_items, output_items):\n\n   \
      \     data = input_items[0]\n\n        for sample in data:\n\n            state\
      \ = 1 if sample > 0.5 else 0\n\n            self.count += 1\n\n            #\
      \ Falling edge = end of HIGH pulse\n            if self.last_state == 1 and\
      \ state == 0:\n\n                pulse = self.count\n                self.decode_pulse(pulse)\n\
      \n                self.count = 0\n\n            self.last_state = state\n\n\n\
      \        self.consume(0, len(data))\n        return 0\n\n\n    def decode_pulse(self,\
      \ pulse):\n\n        # Frame sync\n        if pulse > 4000:\n\n            if\
      \ len(self.bits) > 0:\n                print(\"FRAME:\", self.bits)\n\n    \
      \            msg = pmt.string_to_symbol(self.bits)\n\n                self.message_port_pub(\n\
      \                    pmt.intern(\"out\"),\n                    msg\n       \
      \         )\n\n            self.bits = \"\"\n            return\n\n\n      \
      \  # Ignore noise\n        if pulse > 2000:\n            return\n\n\n      \
      \  # Pulse decoding\n        if 200 <= pulse <= 350:\n            self.bits\
      \ += \"0\"\n\n        elif 350 < pulse <= 650:\n            self.bits += \"\
      1\"\n\n        else:\n            print(\"UNKNOWN PULSE:\", pulse)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('RMC555 Pulse Decoder', 'blk', [], [('0', 'float', 1)], [('out', 'message',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1104, 384.0]
    rotation: 0
    state: enabled
